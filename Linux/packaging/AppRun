#!/bin/sh
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export APPDIR
export PYTHONHOME="$APPDIR/usr"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export TCL_LIBRARY="$APPDIR/usr/share/tcltk/tcl8.6"
export TK_LIBRARY="$APPDIR/usr/share/tcltk/tk8.6"
unset PYTHONPATH PYTHONSTARTUP PYTHONUSERBASE
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/lighttouch${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$APPDIR/usr/bin/python3" -s "$APPDIR/usr/share/lighttouch/launcher/main.py" \
    --frontend "$APPDIR/usr/bin/lighttouch-linux" \
    --engine "$APPDIR/usr/lib/lighttouch/libqemu-arm.so" "$@"
