diff --git a/include/hw/arm/host-camera.h b/include/hw/arm/host-camera.h
new file mode 100644
index 0000000..20151e0
--- /dev/null
+++ b/include/hw/arm/host-camera.h
@@ -0,0 +1,59 @@
+/*
+ * The phone's cameras, as the emulated device's camera sensor.
+ *
+ * The A4's camera ISP decides when a frame happens and where it goes; what it
+ * has never had is a picture. This is the other half: two slots, one per sensor,
+ * that the app fills with the phone's own frames and the ISP empties.
+ *
+ * The contract is a viewfinder's, not a queue's. A sensor produces frames
+ * whether or not anyone is looking, and an old frame is worth nothing: the
+ * newest push wins and the one it replaced is dropped. That is why there is no
+ * ring here and no back-pressure -- a slow guest costs a drop, never a delay and
+ * never a buffer that grows.
+ *
+ * Nothing in here knows about QEMU or the ISP: it is a hand-off between threads
+ * (the app's camera thread pushes, the emulator's vCPU thread takes), and the
+ * lock is held only for the swap.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ARM_HOST_CAMERA_H
+#define HW_ARM_HOST_CAMERA_H
+
+#include "qemu/osdep.h"
+
+/* Which sensor a frame belongs to: the two the A4 boards carry. */
+#define HOST_CAMERA_BACK    0       /* MIPI, the one behind the screen's back */
+#define HOST_CAMERA_FRONT   1       /* SMIA, the one above the screen */
+#define HOST_CAMERA_SENSORS 2
+
+/*
+ * The app hands over one frame, NV12 (luma, then interleaved chroma, no
+ * padding), of width x height. The buffer is copied, so the caller keeps its
+ * own. Returns false for a sensor that does not exist or a frame that is not a
+ * plausible size; the app treats that as its own mistake, not a retry.
+ */
+bool host_camera_push(int sensor, const uint8_t *nv12, unsigned width, unsigned height);
+
+/*
+ * The newest frame this sensor has produced since the last take, or NULL. The
+ * pointer stays valid until the next take on the same sensor, which is the
+ * ISP's one use of it: draw it, then ask again next frame.
+ */
+const uint8_t *host_camera_take(int sensor, unsigned *width, unsigned *height);
+
+/* Which sensor the guest is driving: the ISP sets it when the kext names one. */
+void host_camera_select(int sensor);
+int host_camera_active(void);
+
+/*
+ * Counters for the app's own diagnosis: frames pushed, frames the ISP took, and
+ * frames replaced before anything took them. Cheap enough to read every half
+ * second, which is what the Settings line does.
+ */
+void host_camera_counts(int sensor, uint64_t *pushed, uint64_t *taken, uint64_t *replaced);
+
+/* Forget every frame and every count: a guest that restarts gets a clean camera. */
+void host_camera_reset(void);
+
+#endif
