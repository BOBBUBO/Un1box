@@ -1111,3 +1112,35 @@ int qemu_ios_microphone_state(uint32_t *rate, uint32_t *queued, uint64_t *pushed
     }
     return state.capturing ? 1 : 0;
 }
+
+/*
+ * The host's cameras into the emulated device's ISP, one sensor at a time.
+ *
+ * The bridge is the engine's, not a device's: the app pushes a frame whenever
+ * its camera has one, the ISP takes the newest when it draws the next one, and
+ * neither waits for the other. Nothing here touches guest memory or the device
+ * state, so it is safe to call from any thread, including before a machine
+ * exists -- a frame pushed early is just the first viewfinder picture.
+ */
+bool qemu_ios_camera_frame(int sensor, const void *nv12, uint32_t width, uint32_t height)
+{
+    if (!nv12 || !width || !height) {
+        return false;
+    }
+    return host_camera_push(sensor, nv12, width, height);
+}
+
+void qemu_ios_camera_flush(void)
+{
+    host_camera_reset();
+}
+
+int32_t qemu_ios_camera_sensor(void)
+{
+    return host_camera_active();
+}
+
+void qemu_ios_camera_state(int sensor, uint64_t *pushed, uint64_t *taken, uint64_t *replaced)
+{
+    host_camera_counts(sensor, pushed, taken, replaced);
+}
