new file mode 100644
index 0000000..cfdc878
--- /dev/null
+++ b/include/hw/arm/host-camera.h
@@ -0,0 +1,96 @@
+/*
+ * The frontend's camera, as the ISP's output DMA sees it.
+ *
+ * The A4's ISP model produces frames from a test pattern: right for a headless
+ * check (a viewfinder shows something, a still is a still) and useless as a
+ * camera. This is the picture counterpart of hw/arm/host-mic.c: the frontend
+ * pushes what its camera captured, and the ISP hands that to the guest instead
+ * of the pattern.
+ *
+ *   host app -> host_camera_push() -> latest frame per sensor -> isp_frame()
+ *
+ * Latest wins, not a queue. A camera produces frames whether or not the guest
+ * wants them, and a guest that is a frame behind wants the newest picture, not
+ * the oldest: a push replaces the frame the guest has not taken yet, and the
+ * guest takes at most one frame per ISP frame (15 Hz against the camera's 30),
+ * so nothing is ever replayed twice and latency does not grow. That is the one
+ * place this deliberately differs from the microphone's ring, which is a
+ * stream where every sample matters.
+ *
+ * Two sensors: the back one (ISP category 0x03) and the front one (0x04). Each
+ * has its own latest frame, so switching the guest's camera does not show the
+ * other one's picture.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ARM_HOST_CAMERA_H
+#define HW_ARM_HOST_CAMERA_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* The guest's sensors, as the frontend names them. */
+#define HOST_CAMERA_BACK    0
+#define HOST_CAMERA_FRONT   1
+#define HOST_CAMERA_SENSORS 2
+
+/* The largest picture the frontend may push: the A4's sensors' own full size (5 MP stills are
+ * scaled by the ISP model; a preview or a video frame is never this large). */
+#define HOST_CAMERA_MAX_WIDTH  1280
+#define HOST_CAMERA_MAX_HEIGHT 960
+
+/* One sensor's counters, for the state entry point. */
+typedef struct HostCameraSensorState {
+    uint32_t width;             /* the frame waiting for the guest, 0 when none */
+    uint32_t height;
+    uint64_t pushed;            /* frames the frontend handed over since the process began */
+    uint64_t taken;             /* frames the guest's ISP took */
+    uint64_t replaced;          /* frames the guest never saw: superseded before it asked */
+    uint64_t rejected;          /* frames refused: too large, empty, or no such sensor */
+    /* What the guest's ISP is doing with them, as the ISP model last reported it: the mode it asked for, the
+     * layout, whether the last frame was the phone's picture or the test pattern, and how often the guest had
+     * not acknowledged the previous frame or had not given a chroma buffer. This is the diagnosis for "the
+     * camera works on one sensor and hangs on the other", which is otherwise invisible without a trace. */
+    uint32_t mode_width, mode_height, format;   /* 0x11 NV12, 0x10 4:2:2, 0 before the first frame */
+    uint64_t drawn;             /* frames the ISP wrote into the guest's buffers */
+    uint64_t from_phone;        /* of those, the ones drawn from a frame the phone sent */
+    uint64_t unacked;           /* frames skipped: the guest had not cleared the previous interrupt */
+    uint64_t no_chroma;         /* frames drawn for a layout that wanted chroma the guest did not name */
+    uint64_t stalls;            /* frames skipped: no output buffer (a mode being reprogrammed) */
+} HostCameraSensorState;
+
+typedef struct HostCameraState {
+    HostCameraSensorState sensor[HOST_CAMERA_SENSORS];
+} HostCameraState;
+
+/* One frame from the frontend, NV12 (a Y plane of width*height, then interleaved CbCr of
+ * width*height/2), tightly packed, `bytes` = width*height*3/2. Returns true when the frame was
+ * taken (it replaces one the guest has not taken yet) and false when it was refused: an unknown
+ * sensor, a zero or odd size, a size above HOST_CAMERA_MAX_*, or a byte count that does not match.
+ * Any thread; never blocks on the guest. */
+bool host_camera_push(unsigned sensor, const uint8_t *nv12, size_t bytes, unsigned width,
+                      unsigned height);
+
+/* The frame waiting for `sensor`, or NULL when the frontend has pushed nothing new since the last
+ * take. The guest's ISP calls this once per frame; the buffer stays valid until the next take or
+ * push for that sensor. */
+const uint8_t *host_camera_take(unsigned sensor, unsigned *width, unsigned *height);
+
+/* Forget both sensors: the app stopped capturing, or the guest switched cameras. */
+void host_camera_flush(void);
+
+/* The sensor the guest's driver last recognised: the ISP calls this when the kext announces one, and the
+ * frontend asks (host_camera_selected) so it can stream the camera the guest is actually using. A phone
+ * cannot usefully run both cameras at once, so this is how the front camera gets a picture at all. */
+void host_camera_select(unsigned sensor);
+int host_camera_selected(void);
+
+void host_camera_state(HostCameraState *out);
+
+/* The model's own view, reported per frame: what the guest asked for and what it got. Called by the ISP
+ * model; the frontend only reads it. */
+void host_camera_note(unsigned sensor, unsigned mode_width, unsigned mode_height, unsigned format,
+                      bool from_phone, bool unacked, bool no_chroma, bool stall);
+
+#endif
