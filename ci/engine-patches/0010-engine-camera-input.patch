+        unsigned out_y = flip ? h - 1 - y : y;
+        unsigned sy = (unsigned)(((uint64_t)out_y * sh) / h);
+        const uint8_t *lrow = luma + (size_t)sy * sw;
+        const uint8_t *crow = chroma + (size_t)(sy / 2) * sw;
+        uint8_t *drow = dst + (size_t)y * w;
+
+        if (sw == w && nv12) {
+            memcpy(drow, lrow, w);
+            continue;
+        }
+        unsigned sx = 0, err = 0;
+
+        for (unsigned x = 0; x < w; x++) {
+            unsigned read_x = flip ? sw - 1 - sx : sx;
+
+            if (nv12) {
+                drow[x] = lrow[read_x];
+            } else {
+                /* 4:2:2 ('yuvs'): Y Cb Y Cr, one chroma sample per pixel, taken from the pair
+                 * that covers it. */
+                uint8_t *q = drow + (size_t)x * 2;
+
+                q[0] = lrow[read_x];
+                q[1] = crow[read_x & ~1u] ;
+                if (flip ? !(read_x & 1) : (read_x & 1)) {
+                    q[1] = crow[(read_x & ~1u) + 1];
+                }
+            }
+            err += sw;
+            while (err >= w) {
+                err -= w;
+                sx++;
+            }
+        }
+    }
+    if (nv12) {
+        uint8_t *duv = dst + (size_t)w * h;
+        unsigned ch = sh / 2 ? sh / 2 : 1, oh = h / 2 ? h / 2 : 1;
+
+        for (unsigned y = 0; y < oh; y++) {
+            unsigned out_y = flip ? oh - 1 - y : y;
+            unsigned sy = (unsigned)(((uint64_t)out_y * ch) / oh);
+            const uint8_t *crow = chroma + (size_t)sy * sw;
