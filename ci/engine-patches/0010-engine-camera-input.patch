diff --git a/hw/arm/host-camera.c b/hw/arm/host-camera.c
new file mode 100644
index 0000000..b0e5ad1
--- /dev/null
+++ b/hw/arm/host-camera.c
@@ -0,0 +1,160 @@
+/*
+ * The phone's cameras into the emulated device: the slots the app fills and the
+ * ISP empties. See include/hw/arm/host-camera.h for the contract.
+ *
+ * Size limits are here because the two sides disagree about what a frame is: the
+ * app knows the phone's preview sizes (640x480 up to 1280x960), the guest asks
+ * for whatever mode its driver picked. A frame outside these bounds is a bug in
+ * the caller, and taking it would mean the ISP scaling from a buffer that is not
+ * what it claims -- so it is refused and counted, not truncated.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "hw/arm/host-camera.h"
+
+#define HOST_CAMERA_MIN_SIDE    16
+#define HOST_CAMERA_MAX_SIDE    4096
+#define HOST_CAMERA_MAX_FRAME   (HOST_CAMERA_MAX_SIDE * HOST_CAMERA_MAX_SIDE * 3 / 2)
+
+typedef struct HostCameraSlot {
+    QemuMutex lock;
+    uint8_t *frame;             /* one NV12 frame, or NULL before the first push */
+    size_t capacity;
+    unsigned width, height;
+    bool fresh;                 /* pushed since the last take */
+    uint64_t pushed, taken, replaced;
+} HostCameraSlot;
+
+static HostCameraSlot slots[HOST_CAMERA_SENSORS];
+static int active = HOST_CAMERA_BACK;
+static bool initialised;
+
+static void host_camera_init(void)
+{
+    if (initialised) {
+        return;
+    }
+    for (int i = 0; i < HOST_CAMERA_SENSORS; i++) {
+        qemu_mutex_init(&slots[i].lock);
+    }
+    initialised = true;
+}
+
+static HostCameraSlot *slot_for(int sensor)
+{
+    return sensor == HOST_CAMERA_FRONT || sensor == HOST_CAMERA_BACK ? &slots[sensor] : NULL;
+}
+
+bool host_camera_push(int sensor, const uint8_t *nv12, unsigned width, unsigned height)
+{
+    HostCameraSlot *slot;
+
+    host_camera_init();
+    slot = slot_for(sensor);
+    if (!slot || !nv12) {
+        return false;
+    }
+    if (width < HOST_CAMERA_MIN_SIDE || height < HOST_CAMERA_MIN_SIDE ||
+        width > HOST_CAMERA_MAX_SIDE || height > HOST_CAMERA_MAX_SIDE ||
+        (width & 1) || (height & 1)) {
+        return false;
+    }
+
+    size_t need = (size_t)width * height * 3 / 2;
+
+    if (need > HOST_CAMERA_MAX_FRAME) {
+        return false;
+    }
+    qemu_mutex_lock(&slot->lock);
+    if (need > slot->capacity) {
+        slot->frame = g_realloc(slot->frame, need);
+        slot->capacity = need;
+    }
+    memcpy(slot->frame, nv12, need);
+    slot->width = width;
+    slot->height = height;
+    if (slot->fresh) {
+        /* An unread frame is replaced, not queued: this is a viewfinder. */
+        slot->replaced++;
+    }
+    slot->fresh = true;
+    slot->pushed++;
+    qemu_mutex_unlock(&slot->lock);
+    return true;
+}
+
+const uint8_t *host_camera_take(int sensor, unsigned *width, unsigned *height)
+{
+    HostCameraSlot *slot;
+
+    host_camera_init();
+    slot = slot_for(sensor);
+    if (!slot) {
+        return NULL;
+    }
+    qemu_mutex_lock(&slot->lock);
+    const uint8_t *frame = NULL;
+
+    if (slot->fresh) {
+        slot->fresh = false;
+        slot->taken++;
+        if (width) {
+            *width = slot->width;
+        }
+        if (height) {
+            *height = slot->height;
+        }
+        frame = slot->frame;
+    }
+    qemu_mutex_unlock(&slot->lock);
+    return frame;
+}
+
+void host_camera_select(int sensor)
+{
+    host_camera_init();
+    if (slot_for(sensor)) {
+        active = sensor;
+    }
+}
+
+int host_camera_active(void)
+{
+    return active;
+}
+
+void host_camera_counts(int sensor, uint64_t *pushed, uint64_t *taken, uint64_t *replaced)
+{
+    HostCameraSlot *slot;
+
+    host_camera_init();
+    slot = slot_for(sensor);
+    if (!slot) {
+        return;
+    }
+    qemu_mutex_lock(&slot->lock);
+    if (pushed) {
+        *pushed = slot->pushed;
+    }
+    if (taken) {
+        *taken = slot->taken;
+    }
+    if (replaced) {
+        *replaced = slot->replaced;
+    }
+    qemu_mutex_unlock(&slot->lock);
+}
+
+void host_camera_reset(void)
+{
+    host_camera_init();
+    for (int i = 0; i < HOST_CAMERA_SENSORS; i++) {
+        qemu_mutex_lock(&slots[i].lock);
+        slots[i].fresh = false;
+        slots[i].pushed = slots[i].taken = slots[i].replaced = 0;
+        qemu_mutex_unlock(&slots[i].lock);
+    }
+    active = HOST_CAMERA_BACK;
+}
