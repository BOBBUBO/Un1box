 # Synopsys DWC OTG device core, PHY register file and host TCP bridge: shared by the S5L8720 and S5L8930 machines.
 arm_ss.add(when: 'CONFIG_IPOD_TOUCH_1G', if_true: files('ipod_touch_1g.c', 's5l8900_fmc.c', 's5l8900_nand_ecc.c', 's5l8900_adm.c', 's5l8900_lcd_panel.c', 's5l8900_multitouch_z1.c', 'ipod_touch_wm8758.c', 'ipod_touch_piezo.c'))
diff --git a/hw/arm/s5l8930_isp.c b/hw/arm/s5l8930_isp.c
index c2b6ecf..4108b4e 100644
--- a/hw/arm/s5l8930_isp.c
+++ b/hw/arm/s5l8930_isp.c
@@ -25,6 +25,7 @@
 #include "hw/core/sysbus.h"
 #include "hw/core/irq.h"
 #include "hw/arm/s5l8930.h"
+#include "hw/arm/host-camera.h"
 #include "migration/vmstate.h"
 #include "system/address-spaces.h"
 #include "qemu/bswap.h"
@@ -51,10 +52,25 @@
 #define ISP_OUT_FORMAT  0xd3b20     /* 0x11: 4:2:0 biplanar (NV12), 0x10: 4:2:2 */
 
 #define INT_FRAME       0x1000
+
+/* The largest frame the model will write for a mode: 2592x1936 (5 MP) in the 4:2:2 layout, which is
+ * the biggest the A4's sensors offered. Anything above it is a register file that does not describe a
+ * mode yet. */
+#define ISP_FRAME_MAX   (2592u * 1936u * 2u)
 #define ISP_DART_SID    1
 
+typedef struct ISPFrameMap {
+    uint32_t *x;            /* source column for each output column */
+    size_t count;
+    unsigned sw, w;
+} ISPFrameMap;
+
