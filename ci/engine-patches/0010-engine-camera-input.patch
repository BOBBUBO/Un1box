+/*
+ * The phone's picture in the ISP's output layout.
+ *
+ * Both sides use NV12 (luma, then interleaved chroma), so the only work is
+ * size: the phone captures at its own preview size and the guest asked for a
+ * mode's size, and the two differ often enough that it cannot be ignored. It is
+ * nearest neighbour, done a row at a time with a step accumulator -- no division
+ * per pixel, and a frame that is already the right size is a straight copy.
+ *
+ * The front sensor's module sits rotated against the back one, so its picture
+ * arrives upside down; the guest draws what it is given, so it is turned here.
+ */
+static void isp_from_camera(S5L8930ISPState *s, const uint8_t *src, unsigned sw, unsigned sh,
+                            unsigned w, unsigned h, bool nv12, bool flip)
+{
+    uint8_t *dst = s->pic;
+    const uint8_t *luma = src;
+    const uint8_t *chroma = src + (size_t)sw * sh;
+
